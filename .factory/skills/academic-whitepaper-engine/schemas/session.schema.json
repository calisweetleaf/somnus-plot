{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Session Metadata",
  "description": "Session metadata and active state marker for the Academic Whitepaper Engine.",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique identifier for the session."
    },
    "project_name": {
      "type": "string",
      "description": "The name of the project."
    },
    "paper_title": {
      "type": "string",
      "description": "The title of the academic paper."
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the session was created."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the session was last updated."
    },
    "current_state": {
      "type": "integer",
      "minimum": 0,
      "maximum": 11,
      "description": "The current workflow state (0-11)."
    },
    "engine_version": {
      "type": "string",
      "description": "Semantic versioning of the engine.",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "publication_profile": {
      "type": "string",
      "enum": [
        "somnus-research",
        "somnus-patent",
        "technical-memo"
      ],
      "description": "The target publication profile."
    },
    "agent_id": {
      "type": "string",
      "description": "Identifier of the AI model or agent currently active."
    },
    "locked": {
      "type": "boolean",
      "description": "Indicates if the session is currently locked by an agent."
    }
  },
  "required": [
    "session_id",
    "project_name",
    "paper_title",
    "created_at",
    "updated_at",
    "current_state",
    "engine_version",
    "publication_profile",
    "agent_id",
    "locked"
  ]
}
