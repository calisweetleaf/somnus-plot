{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claim Ledger",
  "description": "Epistemological claim classification.",
  "type": "object",
  "properties": {
    "claims": {
      "type": "array",
      "description": "List of claims.",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string",
            "description": "Unique identifier for the claim."
          },
          "claim_text": {
            "type": "string",
            "description": "The textual content of the claim."
          },
          "claim_class": {
            "type": "string",
            "enum": [
              "implemented",
              "observed",
              "derived",
              "interpretive",
              "hypothesized",
              "planned",
              "comparative",
              "historical"
            ],
            "description": "The epistemological class of the claim."
          },
          "source_evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of source_ids or file paths serving as evidence for the claim."
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "description": "Confidence level in the claim (0.0 to 1.0)."
          },
          "target_section": {
            "type": "string",
            "description": "The section of the paper where this claim belongs."
          },
          "citation_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of citation keys supporting the claim."
          },
          "unresolved_dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of unresolved dependencies related to the claim."
          },
          "rhetorical_temperature": {
            "type": "string",
            "enum": [
              "cold",
              "measured",
              "warm",
              "hot"
            ],
            "description": "The rhetorical temperature or tone of the claim."
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Additional notes for the claim."
          }
        },
        "required": [
          "claim_id",
          "claim_text",
          "claim_class",
          "source_evidence",
          "confidence",
          "target_section",
          "citation_keys",
          "unresolved_dependencies",
          "rhetorical_temperature",
          "notes"
        ]
      }
    }
  },
  "required": [
    "claims"
  ]
}
