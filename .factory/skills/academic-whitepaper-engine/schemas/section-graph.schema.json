{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Section Graph",
  "description": "Narrative structure and transition graph.",
  "type": "object",
  "properties": {
    "sections": {
      "type": "array",
      "description": "List of sections in the paper.",
      "items": {
        "type": "object",
        "properties": {
          "section_id": {
            "type": "string",
            "description": "Unique identifier for the section."
          },
          "title": {
            "type": "string",
            "description": "The title of the section."
          },
          "order": {
            "type": "integer",
            "description": "The sequential order of the section."
          },
          "question_answered": {
            "type": "string",
            "description": "The central question this section answers."
          },
          "incoming_assumptions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Assumptions brought into this section."
          },
          "outgoing_conclusion": {
            "type": "string",
            "description": "The conclusion reached at the end of this section."
          },
          "claims_consumed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of claim_ids consumed or addressed in this section."
          },
          "visuals_consumed": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of visual_ids used in this section."
          },
          "transition_to_next": {
            "type": "string",
            "description": "Narrative transition description to the next section."
          },
          "source_file": {
            "type": "string",
            "description": "File path to the markdown section file."
          },
          "word_count_estimate": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Estimated word count for the section."
          }
        },
        "required": [
          "section_id",
          "title",
          "order",
          "question_answered",
          "incoming_assumptions",
          "outgoing_conclusion",
          "claims_consumed",
          "visuals_consumed",
          "transition_to_next",
          "source_file",
          "word_count_estimate"
        ]
      }
    }
  },
  "required": [
    "sections"
  ]
}
